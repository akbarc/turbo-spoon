# Amazon Seller Partner API (SP-API) Credentials
# Get these from: https://developer-docs.amazon.com/sp-api/

SP_REFRESH_TOKEN=your_refresh_token_here
SP_CLIENT_ID=your_client_id_here
SP_CLIENT_SECRET=your_client_secret_here
SP_REGION=us-east-1

# Jungle Scout API Credentials
# Get these from: https://developer.junglescout.com/

JS_API_NAME=your_jungle_scout_api_name_here
JS_API_KEY=your_jungle_scout_api_key_here

# File Configuration

INPUT_CSV=master_product_catalog.csv
OUTPUT_CSV=fba_profit_analysis.csv

# API Rate Limiting
# Seconds to wait between API calls (increase if hitting limits)
RATE_LIMIT=2.0

# Testing - limit number of products to process (leave blank for all)
# MAX_PRODUCTS=10

# Product Filtering
# Only analyze active products (sold AND purchased recently)
FILTER_ACTIVE_ONLY=false
ACTIVE_MONTHS=12
